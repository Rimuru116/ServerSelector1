class MainActivity : ComponentActivity() {

    /** Регион, запуск которого ждёт ответа на системный диалог VPN-разрешения. */
    private var pendingRegion: LockRegion? = null

    private val vpnPermissionLauncher =
        registerForActivityResult(ActivityResultContracts.StartActivityForResult()) { result ->
            val region = pendingRegion
            pendingRegion = null
            if (result.resultCode == RESULT_OK && region != null) {
                dispatchStart(region)
            } else {
                Toast.makeText(
                    this,
                    "Для работы замка нужно разрешение VPN",
                    Toast.LENGTH_LONG
                ).show()
            }
        }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        enableEdgeToEdge(
            statusBarStyle = SystemBarStyle.dark(AndroidColor.TRANSPARENT),
            navigationBarStyle = SystemBarStyle.dark(AndroidColor.TRANSPARENT)
        )

        setContent {
            MLBBServerProTheme(appTheme = AppTheme.NAVY_CYBER) {
                val status by ServerVpnService.status.collectAsState()
                var selectedId by rememberSaveable { mutableStateOf(LockRegion.CIS.id) }
                val selectedRegion = LockRegion.fromId(selectedId) ?: LockRegion.CIS

                // Если сервис уже работает (например, после пересоздания Activity),
                // показываем в списке тот регион, на который реально наложен замок.
                LaunchedEffect(status.region) {
                    status.region?.let { selectedId = it.id }
                }

                RegionLockerScreen(
                    status = status,
                    selectedRegion = selectedRegion,
                    onRegionSelected = { region ->
                        selectedId = region.id
                        // Замок уже включён — переключаем его на новый регион на лету.
                        if (status.isActive) startRegionLock(region)
                    },
                    onToggleLock = {
                        if (status.isActive) stopRegionLock() else startRegionLock(selectedRegion)
                    }
                )
            }
        }
    }

    /** Запрашивает VPN-разрешение (если нужно) и запускает сервис с выбранным регионом. */
    private fun startRegionLock(region: LockRegion) {
        val prepareIntent = VpnService.prepare(this)
        if (prepareIntent == null) {
            dispatchStart(region)
        } else {
            pendingRegion = region
            vpnPermissionLauncher.launch(prepareIntent)
        }
    }

    private fun dispatchStart(region: LockRegion) {
        val intent = Intent(this, ServerVpnService::class.java).apply {
            action = ServerVpnService.ACTION_START
            putExtra(ServerVpnService.EXTRA_REGION_ID, region.id)
        }
        startService(intent)
    }

    private fun stopRegionLock() {
        val intent = Intent(this, ServerVpnService::class.java).apply {
            action = ServerVpnService.ACTION_STOP
        }
        startService(intent)
    }
}

