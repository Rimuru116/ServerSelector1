@Composable
private fun LockStatusPanel(status: LockStatus) {
    val lockedRegion = if (status.isActive) status.region else null

    val accent by animateColorAsState(
        targetValue = if (lockedRegion != null) PingGreen else NavyCardBorder,
        animationSpec = tween(durationMillis = 400),
        label = "statusAccent"
    )
    val container by animateColorAsState(
        targetValue = if (lockedRegion != null) PingGreen.copy(alpha = 0.10f) else NavyCardSurface,
        animationSpec = tween(durationMillis = 400),
        label = "statusContainer"
    )

    Card(
        modifier = Modifier.fillMaxWidth(),
        colors = CardDefaults.cardColors(containerColor = container),
        border = BorderStroke(1.5.dp, accent),
        shape = RoundedCornerShape(20.dp)
    ) {
        Column(
            modifier = Modifier.padding(18.dp),
            verticalArrangement = Arrangement.spacedBy(6.dp)
        ) {
            if (lockedRegion != null) {
                Text(
                    text = "🔒 Замок активен: ${lockedRegion.title}. Чужие серверы блокируются",
                    color = PingGreen,
                    fontSize = 15.sp,
                    fontWeight = FontWeight.Bold
                )
                Text(
                    text = "Заблокировано пакетов: ${status.blockedPackets}",
                    color = TextWhite,
                    fontSize = 13.sp
                )
                if (status.lastBlockedIp != null) {
                    Text(
                        text = "Последний заблокированный узел: ${status.lastBlockedIp}",
                        color = TextMuted,
                        fontSize = 12.sp
                    )
                }
            } else {
                Text(
                    text = "🔓 Замок выключен",
                    color = TextWhite,
                    fontSize = 15.sp,
                    fontWeight = FontWeight.Bold
                )
                if (status.errorMessage != null) {
                    Text(
                        text = status.errorMessage,
                        color = PingRed,
                        fontSize = 12.sp
                    )
                } else {
                    Text(
                        text = "Выберите регион и включите LOCK REGION. Пока замок выключен, трафик игры не фильтруется.",
                        color = TextMuted,
                        fontSize = 12.sp
                    )
                }
            }
        }
    }
}

