/**
 * Состояние замка для UI.
 */
data class LockStatus(
    val isActive: Boolean = false,
    val region: LockRegion? = null,
    val blockedPackets: Long = 0L,
    val lastBlockedIp: String? = null,
    val errorMessage: String? = null
)

/**
 * Server Locker: локальный VPN-сервис, работающий как региональный фаервол.
 *
 * Как это устроено:
 * 1. В TUN-интерфейс маршрутизируются ТОЛЬКО подсети боевых серверов чужих регионов
 *    (ServerLockerEngine.blockedRoutes()). Весь остальной трафик игры (авторизация, лобби,
 *    API Moonton, выбранный регион) уходит в сеть напрямую средствами ОС — без задержек
 *    и без собственного TCP/IP-стека.
 * 2. Сервис читает IP-пакеты из TUN (FileInputStream), разбирает заголовок IPv4,
 *    достаёт Destination IP и спрашивает ServerLockerEngine.shouldBlockPacket(destIp).
 * 3. Заблокированный пакет дропается: он не пишется обратно и не уходит в сеть.
 *
 * VPN привязан только к Mobile Legends (addAllowedApplication), остальные приложения
 * устройства не затрагиваются.
 */
class ServerVpnService : VpnService() {

    @Volatile
    private var tunnel: ParcelFileDescriptor? = null

    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
        when (intent?.action) {
            ACTION_START -> startLock(intent?.getStringExtra(EXTRA_REGION_ID))
            else -> {
                stopLock()
                stopSelf()
            }
        }
        return START_NOT_STICKY
    }

    override fun onRevoke() {
        stopLock()
        super.onRevoke()
    }

    override fun onDestroy() {
        stopLock()
        super.onDestroy()
    }

    // ------------------------------------------------------------------------------------
    // Жизненный цикл замка
    // ------------------------------------------------------------------------------------

    @Synchronized
    private fun startLock(regionId: String?) {
        releaseTunnel()

        val region = LockRegion.fromId(regionId)
        if (region == null) {
            failAndStop("Регион не выбран")
            return
        }

        ServerLockerEngine.activate(region)
        val routes = ServerLockerEngine.blockedRoutes()
        if (routes.isEmpty()) {
            failAndStop("Для выбранного региона нечего блокировать: список подсетей пуст")
            return
        }

        val pfd = try {
            establishTunnel(routes)
        } catch (e: Exception) {
            failAndStop(e.message ?: "Не удалось создать VPN-интерфейс")
            return
        }

        if (pfd == null) {
            failAndStop("Система отклонила VPN-интерфейс. Подтвердите запрос VPN и повторите")
            return
        }

        tunnel = pfd
        _status.value = LockStatus(isActive = true, region = region)

        Thread(Runnable { runPacketLoop(pfd) }, "region-lock-loop").start()
    }

    private fun establishTunnel(routes: List<ServerLockerEngine.Route>): ParcelFileDescriptor? {
        val builder = Builder()
            .setSession("MLBB Server Locker")
            .setMtu(TUN_MTU)
            .addAddress(TUN_ADDRESS, 32)
            .setBlocking(false)

        for (route in routes) {
            builder.addRoute(route.address, route.prefix)
        }

        // Ограничиваем VPN только игрой, чтобы подсети чужих регионов не блокировались
        // для браузера и остальных приложений.
        var attached = 0
        for (packageName in MLBB_PACKAGES) {
            try {
                builder.addAllowedApplication(packageName)
                attached++
            } catch (e: PackageManager.NameNotFoundException) {
                // Такой сборки игры на устройстве нет — пробуем следующий пакет.
            }
        }
        if (attached == 0) {
            throw IllegalStateException("Mobile Legends не найден на устройстве")
        }

        return builder.establish()
    }

    @Synchronized
    private fun stopLock(errorMessage: String? = null) {
        releaseTunnel()
        _status.value = LockStatus(errorMessage = errorMessage)
    }

    @Synchronized
    private fun releaseTunnel() {
        val current = tunnel
        tunnel = null
        if (current != null) {
            try {
                current.close()
            } catch (e: IOException) {
                // Интерфейс уже закрыт.
            }
        }
        ServerLockerEngine.deactivate()
    }

    private fun failAndStop(message: String) {
        stopLock(message)
        stopSelf()
    }

    @Synchronized
    private fun stopIfCurrent(pfd: ParcelFileDescriptor, message: String) {
        if (tunnel === pfd) {
            failAndStop(message)
        }
    }

    private fun publishCounters(pfd: ParcelFileDescriptor, blocked: Long, lastIp: String?) {
        if (tunnel !== pfd) return
        _status.update { current ->
            if (current.isActive) {
                current.copy(blockedPackets = blocked, lastBlockedIp = lastIp)
            } else {
                current
            }
        }
    }

    // ------------------------------------------------------------------------------------
    // Цикл обработки пакетов
    // ------------------------------------------------------------------------------------

    private fun runPacketLoop(pfd: ParcelFileDescriptor) {
        val input = FileInputStream(pfd.fileDescriptor)

        val pollEntry = StructPollfd()
        pollEntry.fd = pfd.fileDescriptor
        pollEntry.events = OsConstants.POLLIN.toShort()
        val pollSet = arrayOf(pollEntry)

        val buffer = ByteArray(MAX_PACKET_SIZE)

        var blockedTotal = 0L
        var lastBlockedIp: String? = null
        var unpublished = false
        var lastPublishAt = SystemClock.elapsedRealtime()

        try {
            while (tunnel === pfd) {
                pollEntry.revents = 0

                // Ждём пакет не дольше POLL_TIMEOUT_MS, чтобы цикл не крутился впустую
                // и вовремя замечал остановку сервиса.
                val ready = try {
                    Os.poll(pollSet, POLL_TIMEOUT_MS)
                } catch (e: ErrnoException) {
                    if (e.errno == OsConstants.EINTR) 0 else throw e
                }

                if (ready > 0) {
                    val events = pollEntry.revents.toInt()
                    if ((events and (OsConstants.POLLHUP or OsConstants.POLLNVAL)) != 0) break

                    if ((events and OsConstants.POLLIN) != 0) {
                        val length = input.read(buffer)
                        if (length < 0) break

                        if (length > 0) {
                            val destIp = extractDestinationIp(buffer, length)
                            if (destIp != null && ServerLockerEngine.shouldBlockPacket(destIp)) {
                                // БЛОКИРОВКА: пакет к чужому боевому серверу дропается —
                                // не пишем его обратно в TUN и не отправляем в сеть.
                                blockedTotal++
                                lastBlockedIp = destIp
                                unpublished = true
                            }
                            // Если shouldBlockPacket вернул false, пакет сюда попасть не должен:
                            // маршруты в TUN строятся без разрешённых подсетей, а остальной трафик
                            // ОС отправляет напрямую. Писать такой пакет обратно в TUN нельзя —
                            // он вернётся в систему как входящий и не дойдёт до сервера.
                        }
                    }
                }

                val now = SystemClock.elapsedRealtime()
                if (unpublished && now - lastPublishAt >= PUBLISH_INTERVAL_MS) {
                    publishCounters(pfd, blockedTotal, lastBlockedIp)
                    unpublished = false
                    lastPublishAt = now
                }
            }
        } catch (e: IOException) {
            // Интерфейс закрыт (остановка замка либо отзыв VPN системой) — выходим из цикла.
        } catch (e: ErrnoException) {
            // Системная ошибка чтения — выходим из цикла.
        } finally {
            if (unpublished) {
                publishCounters(pfd, blockedTotal, lastBlockedIp)
            }
            // Если цикл завершился сам (не по команде остановки), аккуратно гасим замок.
            stopIfCurrent(pfd, "VPN-туннель был закрыт системой. Замок отключён")
        }
    }

    /**
     * Разбирает заголовок IPv4 и возвращает Destination IP (байты 16..19) либо null,
     * если пакет не IPv4 или повреждён.
     */
    private fun extractDestinationIp(packet: ByteArray, length: Int): String? {
        if (length < IPV4_MIN_HEADER_SIZE) return null

        val versionAndIhl = packet[0].toInt() and 0xFF
        val version = versionAndIhl ushr 4
        if (version != 4) return null

        val headerLength = (versionAndIhl and 0x0F) * 4
        if (headerLength < IPV4_MIN_HEADER_SIZE || headerLength > length) return null

        return StringBuilder(15)
            .append(packet[16].toInt() and 0xFF).append('.')
            .append(packet[17].toInt() and 0xFF).append('.')
            .append(packet[18].toInt() and 0xFF).append('.')
            .append(packet[19].toInt() and 0xFF)
            .toString()
    }

    companion object {
        const val ACTION_START = "com.example.serverselector.action.START_REGION_LOCK"
        const val ACTION_STOP = "com.example.serverselector.action.STOP_REGION_LOCK"
        const val EXTRA_REGION_ID = "com.example.serverselector.extra.REGION_ID"

        private const val TUN_ADDRESS = "10.77.0.2"
        private const val TUN_MTU = 1500
        private const val MAX_PACKET_SIZE = 32767
        private const val IPV4_MIN_HEADER_SIZE = 20
        private const val POLL_TIMEOUT_MS = 250
        private const val PUBLISH_INTERVAL_MS = 500L

        /** Пакеты клиента Mobile Legends (Google Play, Xiaomi GetApps, Huawei AppGallery). */
        private val MLBB_PACKAGES = listOf(
            "com.mobile.legends",
            "com.mobilelegends.mi",
            "com.mobilelegends.hwag"
        )

        private val _status = MutableStateFlow(LockStatus())

        /** Живое состояние замка: UI подписывается на него через collectAsState(). */
        val status: StateFlow<LockStatus> = _status.asStateFlow()
    }
