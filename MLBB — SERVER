@Composable
private fun RegionLockerScreen(
    status: LockStatus,
    selectedRegion: LockRegion,
    onRegionSelected: (LockRegion) -> Unit,
    onToggleLock: () -> Unit
) {
    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(
                Brush.verticalGradient(listOf(NavyDarkBackground, Color(0xFF0A1830)))
            )
    ) {
        Column(
            modifier = Modifier
                .fillMaxSize()
                .systemBarsPadding()
                .verticalScroll(rememberScrollState())
                .padding(horizontal = 16.dp, vertical = 12.dp),
            verticalArrangement = Arrangement.spacedBy(14.dp)
        ) {
            ScreenHeader()

            LockStatusPanel(status = status)

            Text(
                text = "Регион матчмейкинга",
                color = TextMuted,
                fontSize = 13.sp,
                fontWeight = FontWeight.SemiBold,
                modifier = Modifier.padding(top = 4.dp)
            )

            LockRegion.values().forEach { region ->
                RegionCard(
                    region = region,
                    selected = region == selectedRegion,
                    onClick = { onRegionSelected(region) }
                )
            }

            LockToggleButton(
                isActive = status.isActive,
                regionTitle = selectedRegion.title,
                onToggle = onToggleLock
            )

            HowItWorksNote()

            Spacer(modifier = Modifier.height(8.dp))
        }
    }
}

