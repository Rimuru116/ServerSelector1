/**
 * Движок Server Locker.
 *
 * Логика: выбранный регион «разрешён», боевые подсети всех остальных регионов — «чужие».
 * - [shouldBlockPacket] отвечает, нужно ли дропнуть пакет к конкретному IP;
 * - [blockedRoutes] отдаёт список маршрутов (чужие подсети минус разрешённые), которые
 *   сервис отправляет в TUN. Всё, что в эти маршруты не попало (авторизация, лобби, API,
 *   выбранный регион), идёт мимо VPN напрямую.
 */
object ServerLockerEngine {

    /** Маршрут для VpnService.Builder.addRoute(address, prefix). */
    data class Route(val address: String, val prefix: Int)

    private class Cidr(rawNetwork: Long, val prefix: Int) {
        private val mask: Long =
            if (prefix == 0) 0L else (0xFFFFFFFFL shl (32 - prefix)) and 0xFFFFFFFFL

        /** Сетевой адрес с обнулёнными хостовыми битами (иначе addRoute бросит "Bad address"). */
        val network: Long = rawNetwork and mask

        fun contains(ip: Long): Boolean = (ip and mask) == network

        fun overlaps(other: Cidr): Boolean {
            val wide = if (prefix <= other.prefix) this else other
            val narrow = if (prefix <= other.prefix) other else this
            return wide.contains(narrow.network)
        }
    }

    private class Snapshot(
        val region: LockRegion,
        val allowed: List<Cidr>,
        val blocked: List<Cidr>,
        val routes: List<Route>
    )

    @Volatile
    private var snapshot: Snapshot? = null

    val activeRegion: LockRegion?
        get() = snapshot?.region

    /** Включает блокировку: разрешён [region], остальные регионы блокируются. */
    fun activate(region: LockRegion) {
        val allowed = region.cidrs.mapNotNull { parseCidr(it) }
        val blocked = LockRegion.values()
            .filter { it != region }
            .flatMap { it.cidrs }
            .mapNotNull { parseCidr(it) }

        val routes = blocked
            .flatMap { block -> subtractAll(block, allowed) }
            .map { Route(longToIp(it.network), it.prefix) }
            .distinct()

        snapshot = Snapshot(region, allowed, blocked, routes)
    }

    fun deactivate() {
        snapshot = null
    }

    fun blockedRoutes(): List<Route> = snapshot?.routes ?: emptyList()

    /**
     * true — пакет к [destIp] нужно дропнуть (боевой сервер чужого региона).
     * false — пакет не трогаем (выбранный регион, авторизация, лобби, API и т.д.).
     */
    fun shouldBlockPacket(destIp: String): Boolean {
        val current = snapshot ?: return false
        val ip = parseIpv4(destIp) ?: return false
        if (current.allowed.any { it.contains(ip) }) return false
        return current.blocked.any { it.contains(ip) }
    }

    private fun subtractAll(block: Cidr, holes: List<Cidr>): List<Cidr> {
        var pieces = listOf(block)
        for (hole in holes) {
            pieces = pieces.flatMap { subtract(it, hole) }
        }
        return pieces
    }

    /** Вычитает подсеть [hole] из подсети [block], возвращая список непересекающихся подсетей. */
    private fun subtract(block: Cidr, hole: Cidr): List<Cidr> {
        if (!block.overlaps(hole)) return listOf(block)
        if (hole.prefix <= block.prefix) return emptyList()

        val childPrefix = block.prefix + 1
        val low = Cidr(block.network, childPrefix)
        val high = Cidr(block.network or (1L shl (32 - childPrefix)), childPrefix)
        return subtract(low, hole) + subtract(high, hole)
    }

    private fun parseCidr(text: String): Cidr? {
        val parts = text.trim().split("/")
        if (parts.size > 2) return null
        val network = parseIpv4(parts[0]) ?: return null
        val prefix = if (parts.size == 2) (parts[1].trim().toIntOrNull() ?: return null) else 32
        if (prefix !in 0..32) return null
        return Cidr(network, prefix)
    }

    private fun parseIpv4(text: String): Long? {
        val octets = text.trim().split(".")
        if (octets.size != 4) return null
        var result = 0L
        for (octet in octets) {
            val value = octet.toIntOrNull() ?: return null
            if (value !in 0..255) return null
            result = (result shl 8) or value.toLong()
        }
        return result
    }

    private fun longToIp(ip: Long): String =
        "${(ip shr 24) and 0xFF}.${(ip shr 16) and 0xFF}.${(ip shr 8) and 0xFF}.${ip and 0xFF}"
}

